# ============================================================================
# Vismaya Frontend Environment Configuration
# ============================================================================
# Copy this file to .env.local to override defaults during development.
# NOTE: Do NOT commit sensitive credentials or live database secrets.

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Mock Mode Switch (Default: true)
# When true (or omitted), the frontend operates 100% on mock/localStorage data.
# When false, enabled modules fetch live data from the backend API.
NEXT_PUBLIC_USE_MOCK=true

# Per-Module Real API Enablement Flags (Active only when NEXT_PUBLIC_USE_MOCK=false)
# Comma-separated list of modules to connect to the real API:
# Supported options: auth, public, talent, recruiter, admin, notifications, uploads, payments
# NOTE: When NEXT_PUBLIC_USE_MOCK=false, an empty/missing NEXT_PUBLIC_API_MODULES means NO module is real (all stay mock).
# Set to '*' or 'all' to connect all modules simultaneously, or list specific modules (e.g. auth,public).
# Example: NEXT_PUBLIC_API_MODULES=auth,public
NEXT_PUBLIC_API_MODULES=
