# ============================================================================
# Vismaya Frontend Environment Configuration (.env.example)
# ============================================================================
# Copy this file to frontend/.env.local for local development.
# Do NOT commit .env.local to version control.

# Backend API Base URL
# Backend runs on port 5000 with route prefix /api/...
# Note: Frontend API client methods append '/api/...' so base URL is http://localhost:5000
# For production on Render: e.g. https://vismaya-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Mock Mode Switch (Default: true for frontend mock demo)
# Set to 'false' to connect frontend modules to live backend API
NEXT_PUBLIC_USE_MOCK=true

# Real API Module Enablement (Active ONLY when NEXT_PUBLIC_USE_MOCK=false)
# Comma-separated list of enabled modules, or '*' / 'all' to enable all modules.
# Supported modules: auth, public, talent, recruiter, admin, notifications, uploads, media, payments, applications, auditions, credits, opportunities, projects, verifications
# Examples:
#   Enable everything: NEXT_PUBLIC_API_MODULES=*
#   Enable specific modules: NEXT_PUBLIC_API_MODULES=auth,public,talent,recruiter,opportunities,applications,auditions,credits
NEXT_PUBLIC_API_MODULES=

# Media Upload Mode
# 'backend' (recommended: streams through backend /api/media to Cloudinary) or 'mock'
NEXT_PUBLIC_MEDIA_UPLOAD_MODE=backend

# Google OAuth Integration (Feature Flag)
# Set to 'true' to display Google Sign-In button on Login and Signup pages
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com

# Cloudinary Client-side Fallback (Optional - server handles uploads securely via /api/media)
# NEVER put CLOUDINARY_API_SECRET in frontend!
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_placeholder
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_placeholder

# Razorpay Integration (Optional)
# Key is provided dynamically by backend in the /api/payments/create-order response.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is optional and only used as a fallback if not provided by backend.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_placeholder
