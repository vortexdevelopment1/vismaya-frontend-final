# ============================================================================
# Vismaya Backend Environment Configuration (.env.example)
# ============================================================================
# Copy this file to backend/.env for local development.
# Do NOT commit .env to version control.

# Server Port & Node Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas URI or local mongodb://localhost:27017/vismaya)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vismaya?retryWrites=true&w=majority
# Optional comma-separated DNS servers for Atlas SRV lookups. Leave empty to use system DNS.
MONGODB_DNS_SERVERS=
# Fail startup promptly instead of leaving the API unavailable indefinitely.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
MONGODB_CONNECT_TIMEOUT_MS=15000

# JWT Authentication Secret (Must be >= 32 characters, cryptographically secure)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_random_string_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins & Frontend Client URL
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CLIENT_URL=http://localhost:3000

# Trust Proxy Hops (Set to 1 when behind a reverse proxy like Render / Cloudflare)
TRUST_PROXY_HOPS=0

# Cloudinary Storage Credentials (Used by backend /api/media upload endpoint)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_placeholder
CLOUDINARY_API_KEY=your_cloudinary_api_key_placeholder
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_placeholder

# Google OAuth Backend Verification
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com

# Payment Gateway (Razorpay) Credentials
# PAYMENT_MODE: 'mock' (local testing) or 'razorpay' (live/test Razorpay API). Default is 'mock'.
# NOTE: In production (NODE_ENV=production), PAYMENT_MODE=mock is strictly prohibited and server will fail to start.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder

# Transactional Email Service (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username_placeholder
SMTP_PASS=your_smtp_password_placeholder
EMAIL_FROM=no-reply@vismayastudios.com

# SMS Gateway Service (Optional)
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_placeholder

# Security / Policy Feature Toggles
ALLOW_LEGACY_TOKENS=false
GUARDIAN_DOC_REQUIRED=true
MAX_ACTIVE_APPLICATIONS=50

# Single Admin Bootstrap & Recovery Credentials (Used only by npm run create-admin / npm run admin:create)
# If omitted, the script prompts interactively without echoing passwords
# Set ADMIN_RESET=true to reset password and clear lockout for the existing administrator
ADMIN_EMAIL=superadmin@example.com
ADMIN_NAME="Primary Administrator"
ADMIN_PASSWORD=
ADMIN_RESET=false

MAX_UNLOCKS_PER_HOUR=20

